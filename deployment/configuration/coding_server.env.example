# Salin ke deployment/configuration/coding_server.env lalu sesuaikan.
# Semua kunci juga bisa diberikan sebagai environment variable.

CS_HOST=0.0.0.0
CS_PORT=8800

# Akun admin pertama (hanya dipakai saat database user masih kosong).
# Bila CS_ADMIN_PASSWORD kosong, password acak ditulis ke workspace/metadata/initial_admin_password.txt
CS_ADMIN_USERNAME=admin
#CS_ADMIN_PASSWORD=

# Token
CS_ACCESS_TOKEN_MINUTES=720
CS_REFRESH_TOKEN_DAYS=30

# Sumber daya (Raspberry Pi 5)
CS_MAX_CONCURRENT_JOBS=2
CS_MAX_QUEUED_JOBS=20
CS_RUN_TIMEOUT=60
CS_BUILD_TIMEOUT=300
CS_MEMORY_LIMIT_MB=1024
CS_MIN_FREE_MEMORY_MB=512
CS_OUTPUT_LIMIT_BYTES=1000000

# Sandbox: auto | bwrap | none   (none TIDAK disarankan)
CS_SANDBOX=auto
CS_SANDBOX_NETWORK=false
CS_TERMINAL_NETWORK=true
CS_TERMINAL_IDLE_TIMEOUT=1800
CS_MAX_TERMINAL_SESSIONS=6

# HTTP client: izinkan tujuan jaringan privat (192.168.x.x, 10.x)?
CS_HTTP_ALLOW_PRIVATE=false

# Backup otomatis harian jam 03:00, simpan N backup terakhir
CS_BACKUP_RETENTION=7

# AI provider OpenAI-compatible (opsional), mis. llama-server lokal
#CS_AI_BASE_URL=http://127.0.0.1:8080
#CS_AI_MODEL=qwen3
#CS_AI_API_KEY=

# AI Coding Agent
#CS_AGENT_MAX_CONCURRENT=1     # task agen aktif bersamaan (model lokal = bottleneck RAM)
#CS_AGENT_MAX_STEPS=60         # batas atas langkah per task
#CS_AGENT_MODEL_TIMEOUT=600    # detik per jawaban model
#CS_AGENT_TASK_TIMEOUT=7200    # detik per sesi berjalan
